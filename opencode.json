{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "scaffolder",
  "instructions": [
    "AGENTS.md",
    "docs/ARCHITECTURE.md",
    "docs/DEVLOG.md"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/github-token}"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "environment": {
          "BROWSER": "chromium"
        }
      },
      "mysql": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@benborla29/mcp-server-mysql"
        ],
        "environment": {
          "MYSQL_HOST": "127.0.0.1",
          "MYSQL_PORT": "3306",
          "MYSQL_USER": "taskflow",
          "MYSQL_PASS": "taskflow",
          "MYSQL_DB": "taskflow"
        }
      },
      "docker": {
        "type": "local",
        "command": [
          "docker",
          "mcp",
          "gateway",
          "run"
        ]
      }
    },
    "taskflow": {
      "type": "local",
      "command": [
        "/Users/bianquiviri/Code/taskflow/scripts/mcp-taskflow.sh"
      ],
      "enabled": true,
      "env": {
        "APP_ENV": "local",
        "MCP_USER_EMAIL": "owner@taskflow.test"
      }
    }
  },
  "agent": {
    "auth-agent": {
      "model": "opencode/big-pickle",
      "mode": "primary"
    },
    "domain-agent": {
      "model": "opencode/big-pickle",
      "mode": "primary"
    },
    "reporting-agent": {
      "model": "opencode/big-pickle",
      "mode": "primary"
    },
    "frontend-agent": {
      "model": "opencode/big-pickle",
      "mode": "primary"
    },
    "infra-agent": {
      "model": "opencode/big-pickle",
      "mode": "primary"
    }
  },
  "permission": {
    "bash": {
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "make test": "allow",
      "make lint": "allow",
      "php artisan *": "allow",
      "composer *": "allow",
      "npm run *": "allow",
      "docker*": "ask",
      "rm -rf *": "deny",
      "*": "ask"
    },
    "edit": "allow",
    "external_directory": {
      "/Users/bianquiviri/Code/**": "allow",
      "*": "ask"
    }
  }
}
